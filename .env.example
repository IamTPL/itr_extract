# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Database & queue ──
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/itr_extract?ssl=disable
REDIS_URL=redis://localhost:6379

# ── Azure AD (Microsoft Entra) ──
# DEV mode: để trống MSAL_TENANT_ID → backend chạy ở chế độ permissive
#   - Chấp nhận token từ bất kỳ Microsoft account (personal/work)
#   - CHỈ dùng cho local dev, KHÔNG deploy public
# PRODUCTION: điền tenant ID của tổ chức khách hàng → strict tenant check
MSAL_TENANT_ID=
MSAL_BE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Storage ──
# Path local nơi lưu PDF + output. Phải có quyền ghi.
# Dev: dùng folder trong project (đã gitignored)
# Production: thường là /var/lib/itr_extract/files
FILES_ROOT=./storage_data

# ── CORS ──
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Google Gemini ──
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
